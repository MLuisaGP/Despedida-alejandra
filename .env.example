# ==========================================
# CONFIGURACIÓN DEL ENTORNO - DESPEDIDA DE SOLTEROS
# ==========================================

# Configuración de la Aplicación
APP_ENV=
APP_DEBUG=
APP_URL=

# Base de Datos MySQL (Coincide con Docker Compose)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# Nota: Si ejecutas PHP de forma local sin Docker, cambia DB_HOST a 127.0.0.1
# y DB_PORT a 3306.

# Datos del Evento (Personalizables)
EVENT_COUPLE==
EVENT_DATE=
EVENT_TIME=
EVENT_VENUE=
EVENT_LOCATION_ADDRESS=
EVENT_MAPS_URL=

# Costos del Sobre / Cooperación
COSTO_INVITADO=350
COSTO_ORGANIZADOR=500

# Límite Máximo de Personas Asistentes
MAX_ATTENDEES=100

# Datos Bancarios para Transferencia (Rellenar con datos reales)
BANK_NAME=
BANK_BENEFICIARY=
BANK_CLABE=
BANK_ACCOUNT=
BANK_CONCEPT=
BANK_WHATSAPP=
